<Window x:Class="PatchyFlow.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchyFlow"
        Width="96" Height="38"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Border x:Name="Pill"
            CornerRadius="12"
            Background="#F0161616"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Margin="3">
        <Grid>
            <Canvas x:Name="BarsCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="58" Height="20" />
            <TextBlock x:Name="StatusText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#CCFFFFFF" FontSize="10" FontFamily="Segoe UI"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
