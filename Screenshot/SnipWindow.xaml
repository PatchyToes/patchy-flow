<Window x:Class="PatchyFlow.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snip"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Black">
    <Canvas x:Name="RootCanvas">
        <Image x:Name="FrozenScreen" Stretch="Fill" />
        <Rectangle x:Name="DimLayer" Fill="#66000000" />
        <Rectangle x:Name="Selection"
                   Stroke="#FFFFFFFF" StrokeThickness="1.5"
                   Fill="#22FFFFFF" Visibility="Collapsed" />
    </Canvas>
</Window>
